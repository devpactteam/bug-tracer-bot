AMPTRACE_LARAVEL_WEBHOOK_URL=https://your-app.example.com/api/telegram/webhook
AMPTRACE_TELEGRAM_WEBHOOK_SECRET=replace-with-your-telegram-webhook-secret
AMPTRACE_RELAY_AUTH_SECRET=replace-with-a-second-private-secret
AMPTRACE_DEPLOYMENT_LOG_ENABLED=false
# Prefer a directory outside the public web root. It must be writable by PHP.
AMPTRACE_DEPLOYMENT_LOG_DIR=/var/log/amptrace-telegram
