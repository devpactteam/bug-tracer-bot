APP_NAME=AMPTrace
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Tehran
# In production, use the public HTTPS URL, e.g. https://panel.example.com.
# Keep these false / empty for local HTTP development.
APP_FORCE_HTTPS=false
HTTPS_HSTS_MAX_AGE=0
SESSION_SECURE_COOKIE=false
# Comma-separated IP addresses or CIDR ranges for a TLS-terminating proxy.
TRUSTED_PROXIES=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=amptrace
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

TELEGRAM_BOT_TOKEN=
# Outbound messages are sent through this intermediary instead of Telegram's API.
TELEGRAM_GATEWAY_URL=https://me.sifb.ir
TELE_CHAT_ID_LOG=
TELEGRAM_KEY_LOG=
TELEGRAM_WEBHOOK_SECRET=
# URL of this Laravel webhook, used directly by Telegram or by deployment/telegram-webhook-relay.php.
LARAVEL_WEBHOOK_URL=https://your-app.example.com/api/telegram/webhook
# Optional shared secret accepted only from the intermediary relay.
TELEGRAM_RELAY_AUTH_SECRET=
TELEGRAM_ALLOWED_OPERATOR_IDS=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_POLL_TIMEOUT=25
TELEGRAM_POLL_LIMIT=100
TELEGRAM_PROXY_TYPE=
TELEGRAM_PROXY_SERVER=
TELEGRAM_PROXY_PORT=
TELEGRAM_PROXY_SECRET=
TELEGRAM_HTTP_PROXY=

INCIDENT_DEBOUNCE_SECONDS=10
INCIDENT_CLARIFICATION_TIMEOUT_MINUTES=30
INCIDENT_MAX_CLARIFICATION_ROUNDS=3
INCIDENT_QUEUE=default

INCIDENT_AI_DRIVER=gapgpt
AI_API_BASE_URL=https://api.gapgpt.app/v1
AI_API_KEY=
AI_MODEL=gpt-5.6-luna

# Second bot that delivers finished tickets to the assigned user. It uses the
# same connection as the main bot (API base + proxy) via long-polling:
#   php artisan telegram:poll-assignee
# Each assignee must /start this bot so their numeric chat_id gets captured on
# support_users.assignee_chat_id by the poll loop.
ASSIGNEE_BOT_TOKEN=
